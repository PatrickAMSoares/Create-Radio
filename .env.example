# Client ID do app criado em https://developer.spotify.com/dashboard
# (é público — pode ir no frontend, inclusive commitado; não é segredo)
VITE_SPOTIFY_CLIENT_ID=coloque_o_client_id_do_seu_app_spotify

# Deve ser IDÊNTICO a um dos Redirect URIs cadastrados no app do Spotify.
# Local:    http://127.0.0.1:5173/callback
# Produção: https://SEU_USUARIO.github.io/Create-Radio/callback
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback
