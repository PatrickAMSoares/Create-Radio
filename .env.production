# Usado pelo GitHub Actions ao gerar o build para o GitHub Pages.
# Não são segredos: o Client ID do Spotify é público por design, e a URL de
# redirect também é pública (aparece no navegador durante o login).
#
# Depois de criar o app em https://developer.spotify.com/dashboard,
# edite este arquivo direto pelo GitHub (ícone de lápis), substitua os dois
# valores abaixo e faça commit — isso já dispara o deploy automático.
VITE_SPOTIFY_CLIENT_ID=coloque_o_client_id_do_seu_app_spotify
VITE_SPOTIFY_REDIRECT_URI=https://SEU_USUARIO.github.io/Create-Radio/callback
