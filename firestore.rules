rules_version = '2';

// Ninguém acessa o Firestore direto do cliente: só as Functions (via Admin
// SDK, que ignora estas regras) leem/escrevem a coleção spotifySessions.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
